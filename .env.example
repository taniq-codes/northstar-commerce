# Vercel Drop: leave CATALOG_MODE=demo for a database-free, non-transactional preview.
CATALOG_MODE=demo
# Core application
APP_NAME=Northstar Market
APP_URL=http://localhost:3000
DEFAULT_CURRENCY=BDT
DEFAULT_LOCALE=en
STORE_TIMEZONE=Asia/Dhaka
# PostgreSQL (local compose configuration)
DATABASE_URL=postgresql://northstar:northstar_dev_only@localhost:5432/northstar?schema=public
DIRECT_URL=postgresql://northstar:northstar_dev_only@localhost:5432/northstar?schema=public
